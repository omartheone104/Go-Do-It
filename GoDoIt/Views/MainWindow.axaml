<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoDoIt.ViewModels"
        xmlns:models="clr-namespace:GoDoIt"
        mc:Ignorable="d"
        x:Class="GoDoIt.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Go Do It"
        Width="1200" Height="700"
        Background="#FAFAFA">

    <Window.Resources>
        <vm:ColorToBrushConverter x:Key="ColorToBrush"/>
    </Window.Resources>

    <Grid ColumnDefinitions="*, 340" RowDefinitions="Auto, *">
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#F8F9FA" Padding="20"
                BorderBrush="#E5E5E5" BorderThickness="0,0,0,2">
            <ItemsControl ItemsSource="{Binding TaskViews}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EventViewModel">
                        <Border Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                CornerRadius="16" Padding="18" Width="200"
                                BoxShadow="0 4 12 0 #25000000">
                            <StackPanel>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="Bold" FontSize="15" Foreground="White"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DueDate, StringFormat='{}{0:M/d/yy}'}"
                                               Foreground="White" Opacity="0.85" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="White" Opacity="0.9"
                                           TextWrapping="Wrap" FontSize="13"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Margin="16" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Calendar Name="calendar"
                          SelectedDate="{Binding SelectedDate}"
                          IsVisible="False"/>
                <TextBlock Name="calendar_text"
                           Text="{Binding SelectedDate}"
                           IsVisible="False"/>
                <vm:CalendarView Tasks="{Binding TaskViews}"
                                 SelectedDate="{Binding SelectedDate}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                Background="#EDE7FF" CornerRadius="20" Margin="0,12,12,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="Task" FontSize="20" FontWeight="Bold" Foreground="#4A3F8C"
                               HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding NewTask.Title}" Watermark="Task title" FontSize="15"/>
                    <TextBox Text="{Binding NewTask.Description}"
                             Watermark="Description" Height="80" AcceptsReturn="True"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Due Date" FontWeight="Medium" Foreground="#5a5a7a"/>
                        <DatePicker SelectedDate="{Binding NewTask.DueDate}"
                                    HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Repeat" FontWeight="Medium" Foreground="#5a5a7a"/>
                        <ComboBox ItemsSource="{Binding RepeatIntervals}"
                                  SelectedItem="{Binding NewTask.RepeatInterval}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Category" FontWeight="Medium" Foreground="#5a5a7a"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding NewTask.Category}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="16" Height="16" CornerRadius="4"
                                                Background="{Binding Color, Converter={StaticResource ColorToBrush}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="White" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Subtask" FontWeight="SemiBold" Foreground="#4A3F8C"/>
                            <TextBox Watermark="Subtask title"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Save Task" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontWeight="Medium"
                            Background="#7B67C8"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="0,10"
                            Command="{Binding SaveTaskCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
