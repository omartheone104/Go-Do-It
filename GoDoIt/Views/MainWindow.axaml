<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoDoIt.ViewModels"
        xmlns:local="clr-namespace:GoDoIt.ViewModels"
        xmlns:models="clr-namespace:GoDoIt"
        mc:Ignorable="d"
        x:Class="GoDoIt.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Go Do It"
        Width="1200" Height="700"
        Background="#FAFAFA"
        RequestedThemeVariant="Light"
        WindowState="Maximized">

    <Window.Resources>
        <vm:ColorToBrushConverter x:Key="ColorToBrush"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid ColumnDefinitions="*, 340" RowDefinitions="Auto, Auto, *">
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <MenuItem Header="_File">
                <MenuItem Header="_Export" Click="Export_Events"/>
                <MenuItem Header="_Import" Click="Import_Events"/>
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding ExitAppCommand}" HotKey="Ctrl+Q"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Delete Selected" Command="{Binding DeleteTaskCommand}" IsEnabled="{Binding IsEditing}"/>
                <MenuItem Header="Delete All" Command="{Binding DeleteAllTasksCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About Go Do It" Command="{Binding AboutAppCommand}"/>
            </MenuItem>
        </Menu>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#F8F9FA" Padding="20"
                BorderBrush="#E5E5E5" BorderThickness="0,0,0,2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                <StackPanel Margin="0,0,20,0">
                    <ItemsControl ItemsSource="{Binding RootTaskViews}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventViewModel">
                                <Border Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                        CornerRadius="16" Padding="18" Width="200"
                                        BoxShadow="0 4 12 0 #25000000"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        PointerPressed="OnTaskCardPressed"
                                        PointerMoved="OnTaskCardPointerMoved">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Grid Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold" FontSize="15" Foreground="White"/>
                                                <Line StartPoint="0,0" EndPoint="1,0" Stretch="Fill"
                                                      Stroke="White" Opacity="0.8" StrokeThickness="1.5"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding IsComplete}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding DueDate, StringFormat='{}{0:M/d/yy}'}"
                                                    Foreground="White" Opacity="0.85" FontSize="12"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Background="#33FFFFFF" CornerRadius="6" Padding="6,2"
                                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                                IsVisible="{Binding IsComplete}">
                                            <TextBlock Text="✓ Done" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Description}"
                                                Foreground="White" Opacity="0.9"
                                                TextWrapping="Wrap" FontSize="13"
                                                Margin="0,6,0,0"/>
                                        <ItemsControl ItemsSource="{Binding Subtasks}"
                                                    IsVisible="{Binding HasSubtasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EventViewModel">
                                                    <Border Background="#33FFFFFF"
                                                            CornerRadius="8" Padding="8,4" Margin="0,2,0,0">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="11" Foreground="White"
                                                                       TextWrapping="NoWrap"/>
                                                            <Line StartPoint="0,0" EndPoint="1,0" Stretch="Fill"
                                                                  Stroke="White" Opacity="0.8" StrokeThickness="1.2"
                                                                  VerticalAlignment="Center"
                                                                  IsVisible="{Binding IsComplete}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.Column="0"
                Margin="16" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Calendar Name="calendar" SelectedDate="{Binding SelectedDate}" IsVisible="False" DragDrop.AllowDrop="True"/>
                <TextBlock Name="calendar_text" Text="{Binding SelectedDate}" IsVisible="False"/> 
                <vm:CalendarView Tasks="{Binding TaskViews}"
                                 SelectedDate="{Binding SelectedDate}"
                                 SelectTaskCommand="{Binding SelectTaskCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1"
                Background="#EDE7FF" CornerRadius="20" Margin="0,12,12,12">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,20,24,0">
                    <TextBlock Text="{Binding PanelTitle}"
                               FontSize="20" FontWeight="Bold" Foreground="#4A3F8C"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsTaskPanelVisible}"/>
                    <TextBlock Text="Categories"
                               FontSize="20" FontWeight="Bold" Foreground="#4A3F8C"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsCategoryPanelOpen}"/>

                    <Button Grid.Column="1"
                            Content="☰ Categories"
                            IsVisible="{Binding IsTaskPanelVisible}"
                            Command="{Binding OpenCategoryPanelCommand}"
                            Background="#7B67C8" Foreground="White"
                            CornerRadius="8" Padding="8,4" FontSize="12"/>
                    <Button Grid.Column="1"
                            Content="✕ Close"
                            IsVisible="{Binding IsCategoryPanelOpen}"
                            Command="{Binding CloseCategoryPanelCommand}"
                            Background="Transparent" Foreground="#4A3F8C"
                            Padding="4" FontSize="13"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding IsTaskPanelVisible}"
                              VerticalScrollBarVisibility="Auto">
                    <Border
                        Background="Transparent"
                        Cursor="Hand"
                        PointerPressed="OnDraftTaskPressed"
                        PointerMoved="OnDraftTaskPointerMoved">
                        <StackPanel Margin="24,12,24,24" Spacing="14">

                            <Button Content="✕ Cancel"
                                    IsVisible="{Binding CanCancel}"
                                    Command="{Binding ClearSelectionCommand}"
                                    Background="Transparent" Foreground="#4A3F8C"
                                    HorizontalAlignment="Right" Padding="4" FontSize="12"/>

                            <TextBox Text="{Binding NewTask.Title}" Watermark="Task title" FontSize="15"/>
                            <TextBox Text="{Binding NewTask.Description}"
                                    Watermark="Description" Height="80" AcceptsReturn="True"
                                    TextWrapping="Wrap"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Due Date" FontWeight="Medium" Foreground="#5a5a7a"/>
                                <DatePicker SelectedDate="{Binding NewTask.DueDate}"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Repeat" FontWeight="Medium" Foreground="#5a5a7a"/>
                                <ComboBox ItemsSource="{Binding RepeatIntervals}"
                                          SelectedItem="{Binding NewTask.RepeatInterval}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Category" FontWeight="Medium" Foreground="#5a5a7a"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding NewTask.Category}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Category">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="16" Height="16" CornerRadius="4"
                                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Border Background="White" CornerRadius="12" Padding="14" IsVisible="{Binding HasParentTask}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Parent Task" FontWeight="SemiBold" Foreground="#4A3F8C"/>
                                    <TextBlock Text="{Binding ParentTaskTitle}" FontSize="14" Foreground="#333"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Add Subtask"
                                    IsVisible="{Binding CanAddSubtask}"
                                    Command="{Binding AddSubtaskCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="White"
                                    BorderBrush="#E5E5E5"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    FontWeight="SemiBold"
                                    Foreground="#4A3F8C"/>

                            <Button Content="{Binding ToggleCompleteLabel}"
                                    IsVisible="{Binding IsEditing}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" 
                                    FontWeight="Medium"
                                    Background="#4CAF50" Foreground="White"
                                    CornerRadius="8" Padding="0,10"
                                    Command="{Binding ToggleCompleteCommand}"/>

                            <Button Content="{Binding PanelSaveLabel}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontWeight="Medium"
                                    Background="#7B67C8" Foreground="White"
                                    CornerRadius="8" Padding="0,10"
                                    Command="{Binding SaveTaskCommand}"/>

                            <Button Content="Delete Task"
                                    IsVisible="{Binding IsEditing}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    FontWeight="Medium"
                                    Background="#C84F4F" Foreground="White"
                                    CornerRadius="8" Padding="0,10"
                                    Command="{Binding DeleteTaskCommand}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding IsCategoryPanelOpen}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,12,24,24" Spacing="14">
                        <Border Background="White" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="New Category" FontWeight="SemiBold" Foreground="#4A3F8C"/>
                                <TextBox Text="{Binding NewCategory.Name}"
                                         Watermark="Category name" FontSize="14"/>

                                <TextBlock Text="Color" FontWeight="Medium" Foreground="#5a5a7a" FontSize="13"/>
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="28" Height="28" CornerRadius="6"
                                                    Margin="3"
                                                    Background="{Binding Converter={StaticResource ColorToBrush}}"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    PointerPressed="OnColorSwatchPressed"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Selected:" Foreground="#5a5a7a" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <Border Width="24" Height="24" CornerRadius="6"
                                            Background="{Binding NewCategory.SelectedColor, Converter={StaticResource ColorToBrush}}"/>
                                </StackPanel>

                                <Button Content="Add Category"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Background="#7B67C8" Foreground="White"
                                        CornerRadius="8" Padding="0,8"
                                        Command="{Binding AddCategoryCommand}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Existing Categories" FontWeight="SemiBold"
                                   Foreground="#4A3F8C" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <Border Background="White" CornerRadius="10"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Border Width="20" Height="20" CornerRadius="5"
                                                    Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="14" VerticalAlignment="Center"
                                                       Foreground="Black"
                                                       Margin="10,0,0,0"/>
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Background="Transparent"
                                                    Foreground="#C84F4F"
                                                    Padding="4,2"
                                                    FontSize="13"
                                                    Tag="{Binding}"
                                                    Click="OnDeleteCategoryClicked"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
